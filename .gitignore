# Configuración local, credenciales y secretos
conf/local/**
!conf/local/
!conf/local/.gitkeep
conf/**/*credentials*
.env
.env.*

# Decisión 2026-08: se versionan datos anonimizados, parquet, modelos y
# razonamientos para máxima reproducibilidad (repo público, decisión de Federico).
/notebooks/*
!/notebooks/.gitkeep
# Extracto del dataset original-original (1.146 cols, contiene PII cruda):
# SOLO local, NUNCA versionar
/data/00_original/

# Fuentes de trabajo local que no se publican: notebooks fuente, catálogo de
# conocimiento y configuración de agentes
/nbs/
/knowledge/
/.pi/

# Material histórico o temporal que no es fuente vigente
/tmp/
/archived/
/backups/
/build_*/
/build/
/dist/
/site/

# Bibliografía local: el inventario BibTeX sí puede versionarse
/bibliografia/*.pdf
!/bibliografia/references.bib

